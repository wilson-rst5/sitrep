# Run scripts/init-env.sh to generate .env.
POSTGRES_PASSWORD=
SETUP_TOKEN=
PUBLIC_ORIGIN=http://localhost:8080
SECURE_COOKIES=false
SITREP_BIND=127.0.0.1
SITREP_PORT=8080
ENABLED_PROVIDERS=usgs,ipma-warnings,ipma-observations,ipma-forecasts,nasa-eonet,noaa-news
MAP_STYLE_URL=
MAP_LIGHT_STYLE_URL=
MAP_DARK_STYLE_URL=
MAP_FALLBACK_STYLE_URL=
GEOCODER_URL=
GEOCODER_SEARCH_URL=
GEOCODER_TOKEN=
TOMTOM_API_KEY=
TOMTOM_TRAFFIC_BBOX=
TRANSITO_AGORA_API_KEY=
TOMTOM_FLOW_ENABLED=false
TOMTOM_INCIDENTS_ENABLED=false
TOMTOM_SEGMENT_ENABLED=false
FIRMS_MAP_KEY=
FIRMS_BBOX=

# ADSB.lol keyless tracking is enabled by default. See docs/aviation.md.
ADSBLOL_ENABLED=true
ADSBLOL_API_KEY=
OPENSKY_CLIENT_ID=
AVIATION_POLL_SECONDS=200
